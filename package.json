{
  "name": "shopify-webhook-mcp-server",
  "version": "1.0.0",
  "description": "Advanced MCP Server for Shopify integration with abandoned checkout recovery and marketing automation using the official MCP SDK",
  "main": "server.js",
  "type": "module",
  "bin": {
    "shopify-webhook-mcp": "./server.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mcp": "MCP_MODE=true node server.js",
    "mcp-stdio": "MCP_MODE=true node server.js",
    "webhook": "node ./src/webhook-handler.js",
    "install-deps": "npm install",
    "test": "vitest",
    "lint": "eslint --config eslint.config.js src/ server.js",
    "lint:fix": "eslint --config eslint.config.js src/ server.js --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "abandoned-checkout",
    "marketing-automation",
    "ai",
    "chatgpt",
    "claude"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": {
      "node": "^20.16.0 || >=22.0.0"
    }
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": [
        "server.js"
      ],
      "env": {
        "NODE_ENV": "production",
        "MCP_MODE": "true"
      }
    }
  }
}
